# Bot Configuration
BOT_TOKEN=your_bot_token_here_from_@BotFather
ADMIN_IDS=123456789,987654321  # Comma-separated Telegram user IDs

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/account_bot

# Payment Configuration (Optional)
PAYMENT_PROVIDER=razorpay  # razorpay, paytm, phonepe
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# UPI Configuration (For manual payments)
UPI_ID=your.upi@id  # Your UPI ID for manual payment verification
SUPPORT_USERNAME=@Senkaizen  # Support contact

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log